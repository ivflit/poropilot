# Copy to .env and fill in. NEVER commit the real .env.

# Riot developer key — https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Which Claude model the AI features use.
#   claude-haiku-4-5  ($1/$5 per 1M)  — cheapest, good default for a hobby project
#   claude-sonnet-5   ($3/$15)        — stronger draft reasoning
#   claude-opus-4-8   ($5/$25)        — most capable
ANTHROPIC_MODEL=claude-haiku-4-5

# Optional — falls back to in-memory cache if unset
# REDIS_URL=redis://localhost:6379/0
