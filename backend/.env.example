# Copy to .env and fill in. NEVER commit the real .env.

# Riot developer key — https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- AI features (draft assistant + patch digest) ---
# ALL OPTIONAL: leave the keys blank to run without AI. The AI features switch off
# automatically (the app and all Riot-powered features still work).
#
# Provider: leave blank to auto-detect from whichever key is set (Anthropic first),
# or force it to "anthropic" or "gemini".
AI_PROVIDER=

# Option A — Anthropic (paid) — https://console.anthropic.com
ANTHROPIC_API_KEY=
#   claude-haiku-4-5 (cheap) · claude-sonnet-5 · claude-opus-4-8 (most capable)
ANTHROPIC_MODEL=claude-haiku-4-5

# Option B — Google Gemini (free tier) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional — falls back to in-memory cache if unset
# REDIS_URL=redis://localhost:6379/0

# --- Database (accounts) ---
# Postgres connection string. Leave unset to run without auth (all Riot features
# still work). Free tier: Neon (https://neon.tech) or Render Postgres.
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Secret for signing JWTs. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET=

# --- CORS ---
# Which frontend origins may call this API. Comma-separated, no trailing slashes.
# Defaults to the Vite dev server, so you only need this when the frontend is hosted
# somewhere else (e.g. Netlify + Render).
# CORS_ORIGINS=https://poropilot.netlify.app,https://poropilot.app
#
# Optional regex for origins you can't list up front — Netlify deploy previews get a
# fresh subdomain per build.
# CORS_ORIGIN_REGEX=https://.*--poropilot\.netlify\.app
