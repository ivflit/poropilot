# Copy to .env.local for local overrides. Vite only exposes VITE_-prefixed variables,
# and it inlines them into the bundle at build time — so these are PUBLIC. Never put a
# secret here, and remember a change needs a rebuild, not just a restart.

# Base URL of the PoroPilot API. Defaults to http://localhost:8000 when unset.
#   local (backend on the host or via docker compose):  http://localhost:8000
#   split hosting (Netlify frontend + Render backend):  https://poropilot-api.onrender.com
#   same-origin behind Nginx (deploy/web.Dockerfile):   leave it empty
VITE_API_BASE=http://localhost:8000
